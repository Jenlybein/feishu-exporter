{
   "action": {
      "default_icon": {
         "128": "icons/128.png",
         "16": "icons/16.png",
         "32": "icons/32.png",
         "48": "icons/48.png"
      },
      "default_title": "飞书批量导出助手"
   },
   "background": {
      "service_worker": "src/background/index.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "src/content.js" ],
      "matches": [ "https://*.feishu.cn/*", "https://*.feishu.net/*", "https://*.feishu.cttq.com/*" ],
      "run_at": "document_end"
   } ],
   "description": "飞书批量导出助手：在飞书文档页批量导出 Word / PDF / Markdown / HTML / 附件。",
   "host_permissions": [ "https://*.feishu.cn/*", "https://*.feishu.net/*", "https://*.feishu.cttq.com/*" ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
   },
   "manifest_version": 3,
   "name": "飞书批量导出助手",
   "permissions": [ "debugger", "downloads", "sidePanel", "scripting", "tabs" ],
   "side_panel": {
      "default_path": "src/sidepanel/sidepanel.html"
   },
   "web_accessible_resources": [
      {
         "resources": [ "src/injected/*.js" ],
         "matches": [ "https://*.feishu.cn/*", "https://*.feishu.net/*", "https://*.feishu.cttq.com/*" ]
      }
   ],
   "version": "0.1.5"
}
